# 复制为 .env 后按需修改（backend/app/core/config.py 全部经环境变量读取）
YUE2_MODEL_REPO=m-a-p/YuE2-3B
YUE2_DEVICE=cuda
YUE2_OUTPUT_DIR=./outputs
YUE2_PORT=8000
# compose 下浏览器只访问 web:80；直连 api 调试时再加你的域名，逗号分隔；不要用 "*"
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1,http://localhost
YUE2_MAX_QUEUE=10
# 每 IP 每小时最多提交次数（防一人刷满队列）；0 = 不限
YUE2_SUBMIT_PER_HOUR=20
# 长度上限（改后需重启；需与前端 maxlength 保持一致）
YUE2_MAX_TITLE=100
YUE2_MAX_STYLE=2000
YUE2_MAX_LYRICS=10000
LOG_LEVEL=INFO
# 管理接口总开关：为空=禁用 /api/admin/*（默认最安全）；设长随机串后重启生效
ADMIN_TOKEN=
# 用 GHCR 预构建镜像时取消注释（Actions 手动构建工作流产物），免去部署机本地构建
# YUE2_API_IMAGE=ghcr.io/<owner>/yue2-api:latest
# YUE2_WEB_IMAGE=ghcr.io/<owner>/yue2-web:latest
